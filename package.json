{
  "name": "excali-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1",
    "build": "bun --bun tsc -b && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "tauri": "bun ./node_modules/.bin/tauri",
    "desktop": "bun run tauri dev",
    "desktop:build": "bun run tauri build",
    "test": "bun test",
    "postinstall": "bun scripts/copy-fonts.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@tauri-apps/api": "^2.8.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  }
}
